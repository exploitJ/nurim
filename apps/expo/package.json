{
  "name": "@acme/expo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "prebuild:bootsplash": "react-native-bootsplash generate --project-type 'expo' --platforms 'android,ios' --background '#1F104A' './app-logo.svg' --assets-output 'assets/bootsplash'",
    "android": "expo run:android",
    "android:build": "expo run:android --no-bundler",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:build": "expo run:ios --no-bundler",
    "ios:release": "expo run:ios --configuration Release",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-config": "0.20.0-canary-20250331-817737a",
    "@gorhom/bottom-sheet": "^5.1.1",
    "@react-native-picker/picker": "2.11.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@shopify/flash-list": "1.8.0",
    "@shopify/react-native-skia": "2.0.0-next.2",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "expo": "53.0.0-canary-20250331-817737a",
    "expo-build-properties": "0.14.0-canary-20250331-817737a",
    "expo-constants": "18.0.0-canary-20250331-817737a",
    "expo-dev-client": "5.0.17",
    "expo-linking": "7.1.0-canary-20250331-817737a",
    "expo-localization": "16.1.0-canary-20250331-817737a",
    "expo-router": "5.0.0-canary-20250331-817737a",
    "expo-secure-store": "14.0.2-canary-20250331-817737a",
    "expo-splash-screen": "0.29.23-canary-20250331-817737a",
    "expo-system-ui": "5.0.0-canary-20250331-817737a",
    "expo-web-browser": "14.1.0-canary-20250331-817737a",
    "nativewind": "~4.1.23",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.79.0-rc.4",
    "react-native-css-interop": "~0.1.22",
    "react-native-edge-to-edge": "^1.5.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-controller": "^1.16.8",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~3.17.1",
    "react-native-safe-area-context": "~5.3.0",
    "react-native-screens": "4.10.0",
    "superjson": "2.2.2"
  },
  "devDependencies": {
    "@acme/api": "workspace:*",
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/runtime": "^7.26.10",
    "@types/babel__core": "^7.20.5",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-picker/picker",
        "@react-native-segmented-control/segmented-control",
        "@shopify/flash-list",
        "@shopify/react-native-skia",
        "react-native"
      ]
    }
  },
  "prettier": "@acme/prettier-config"
}
