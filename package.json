{
  "name": "nurim",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "root:clean": "git clean -xdf .cache .turbo node_modules",
    "root:format": "prettier --check .github/ .vscode/ *.*",
    "build": "turbo run build",
    "build:desktop": "turbo run desktop#build:unpack",
    "release": "turbo run desktop#build:pack",
    "clean": "turbo run clean root:clean",
    "auth:generate": "pnpm -F @acme/auth generate",
    "db:push": "turbo -F @acme/db push",
    "db:studio": "turbo -F @acme/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @acme/nextjs...",
    "ci:check": "turbo run format lint",
    "preformat": "pnpx prettierignore-monorepo@latest",
    "format": "turbo run format root:format --continue -- --check --cache --cache-location .cache/prettiercache --experimental-cli",
    "format:fix": "turbo run format root:format --continue -- --write --cache --cache-location .cache/prettiercache --experimental-cli",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/eslintcache",
    "lint:ws": "pnpx sherif@latest",
    "postinstall": "pnpm lint:ws --fix --select highest",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "knip": "knip"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@turbo/gen": "^2.8.12",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "knip": "^5.82.0",
    "prettier": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
