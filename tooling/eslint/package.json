{
  "name": "@acme/eslint-config",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.ts",
    "./nextjs": "./nextjs.ts",
    "./react": "./react.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier . --ignore-path ../../.prettierignore --check --cache --cache-location .cache/prettiercache",
    "format:fix": "prettier . --ignore-path ../../.prettierignore --write --cache --cache-location .cache/prettiercache",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "^16.1.6",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.8.14",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.2",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.56.1"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
